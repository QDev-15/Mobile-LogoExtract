<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<!-- Android only for now, same decision as the sibling DocScanner/PdfReader repos (owner has no Mac,
		     iOS to be added later from a fresh `dotnet new maui` template if ever needed). -->
		<TargetFrameworks>net10.0-android</TargetFrameworks>

		<OutputType>Exe</OutputType>
		<RootNamespace>LogoExtract</RootNamespace>
		<UseMaui>true</UseMaui>
		<SingleProject>true</SingleProject>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>

		<MauiXamlInflator>SourceGen</MauiXamlInflator>

		<ApplicationTitle>Logo Extract</ApplicationTitle>
		<ApplicationId>btk.logoextract</ApplicationId>

		<ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
		<ApplicationVersion>3</ApplicationVersion>

		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">26.0</SupportedOSPlatformVersion>

		<!-- Ads mode / master switch: same two properties and meaning as DocScanner/PdfReader (see those repos'
		     csproj comments for the full reasoning). Dev (default) uses sandbox/no ad units; only Pro (passed
		     explicitly for the one build that goes to Play) uses real ones from RealAdsConfig.cs. 

			 dotnet publish LogoExtract/LogoExtract.csproj -f net10.0-android -c Release
			 dotnet publish LogoExtract/LogoExtract.csproj -f net10.0-android -c Release -p:AndroidPackageFormat=aab -p:AdsMode=Pro -p:AdsEnabled=true
			 dotnet publish LogoExtract/LogoExtract.csproj -f net10.0-android -c Release -p:AndroidPackageFormat=aab -p:AdsMode=Dev -p:AdsEnabled=true
			 dotnet publish LogoExtract/LogoExtract.csproj -f net10.0-android -c Release -p:AndroidPackageFormat=aab -p:AdsMode=Dev -p:AdsEnabled=false 
			 -->
		<AdsMode Condition="'$(AdsMode)' == ''">Dev</AdsMode>
		<DefineConstants Condition="'$(AdsMode)' == 'Pro'">$(DefineConstants);ADS_MODE_PRO</DefineConstants>
		<AdsEnabled Condition="'$(AdsEnabled)' == ''">true</AdsEnabled>
		<DefineConstants Condition="'$(AdsEnabled)' == 'false'">$(DefineConstants);ADS_DISABLED</DefineConstants>
	</PropertyGroup>

	<PropertyGroup Condition="'$(Configuration)' == 'Debug'">
		<UseInterpreter>false</UseInterpreter>
	</PropertyGroup>

	<PropertyGroup Condition="'$(Configuration)' == 'Release'">
		<AndroidEnableProfiledAot>true</AndroidEnableProfiledAot>
		<EnableLLVM>false</EnableLLVM>
		<AndroidLinkTool>r8</AndroidLinkTool>
		<!-- AndroidLinkMode.Full confirmed 2026-10-28 (matched A/B test: Debug ~3s vs Release+Full stuck for
		     minutes on the SAME device/photo; Release+None back to ~3s) as the root cause of this build's
		     segmentation hang/slowness. R8's full code-shrink pass was removing something ONNX Runtime's C#
		     bindings reach only via reflection, the same risk class already documented for this setting in the
		     sibling PdfReader.csproj. SdkOnly (shrink only SDK/library assemblies, never this app's own code)
		     measured just as fast as None on the same device while still trimming real size out of the APK. -->
		<AndroidLinkMode>SdkOnly</AndroidLinkMode>
	</PropertyGroup>

	<!-- Upload-signing config (keystore path/passwords, AndroidPackageFormat=aab): lives in release\Signing.props,
	     gitignored (see release\KEYSTORE-README.md), same shape as DocScanner/PdfReader's own setup. Conditioned on
	     Exists(...) so a Debug build, or a fresh checkout without this local-only folder, never fails. -->
	<Import Project="release\Signing.props" Condition="'$(Configuration)' == 'Release' AND Exists('release\Signing.props')" />

	<Target Name="CopyReleaseAabWithVersion" AfterTargets="Publish"
	        Condition="'$(Configuration)' == 'Release' AND '$(AndroidPackageFormat)' == 'aab'">
		<ItemGroup>
			<_SignedAab Include="$(PublishDir)*-Signed.aab" />
		</ItemGroup>
		<!-- One folder per build, release\LogoExtract-<version>-<code>\, holding the bundle and the R8 mapping.txt of that
		     exact build (every build makes a different mapping; keep the pair together). The mapping is also inside the
		     .aab itself (BUNDLE-METADATA), so Play needs no separate upload; this copy is for manual upload / archive. -->
		<PropertyGroup>
			<_ReleaseName>LogoExtract-$(ApplicationDisplayVersion)-$(ApplicationVersion)</_ReleaseName>
			<_ReleaseDir>release\$(_ReleaseName)\</_ReleaseDir>
			<_ReleaseMapping>$(OutputPath)mapping.txt</_ReleaseMapping>
		</PropertyGroup>
		<!-- Warn when the build was NOT obfuscated (this project does not set AndroidR8ObfuscationMode at all
		     yet, unlike PdfReader/DocScanner, so this always fires today — a reminder, not a blocker): such an
		     AAB keeps Play's "DEX code optimization" obfuscation score below 25%. There is no build-release.ps1
		     in this repo (that script, which points dotnet at a newer Android SDK supporting
		     AndroidR8ObfuscationMode, only exists in the sibling PdfReader/DocScanner repos) — adopting real
		     obfuscation here means doing the same setup there first. -->
		<ReadLinesFromFile File="$(IntermediateOutputPath)proguard\proguard_xamarin.cfg" Condition="Exists('$(IntermediateOutputPath)proguard\proguard_xamarin.cfg')">
			<Output TaskParameter="Lines" ItemName="_ProguardXamarinLine" />
		</ReadLinesFromFile>
		<ItemGroup>
			<_NoObfuscationLine Include="@(_ProguardXamarinLine)" Condition="'%(Identity)' == '-dontobfuscate'" />
		</ItemGroup>
		<Warning Condition="'@(_NoObfuscationLine)' != ''" Text="This build is NOT obfuscated (AndroidR8ObfuscationMode not set in this project; see the comment above)." />
		<MakeDir Directories="$(_ReleaseDir)" Condition="'@(_SignedAab)' != ''" />
		<Copy SourceFiles="@(_SignedAab)" DestinationFiles="$(_ReleaseDir)$(_ReleaseName).aab" Condition="'@(_SignedAab)' != ''" />
		<Copy SourceFiles="$(_ReleaseMapping)" DestinationFiles="$(_ReleaseDir)mapping.txt" Condition="'@(_SignedAab)' != '' AND Exists('$(_ReleaseMapping)')" />
		<Message Importance="high" Condition="'@(_SignedAab)' != ''" Text="Release build copied to $(_ReleaseDir) (aab + mapping.txt)" />
	</Target>
	<ItemGroup>
		<!-- Color is the flat fallback background some platform paths use even with the SVG present. Updated
		     2026-10-28 (icon-replacement pass, owner-provided reference image) from #1FAE82 (old mint) to
		     #392A24, the midpoint of the new dark-brown gradient's two stops (appicon.svg); it also lands
		     almost exactly on the flat brown sampled directly from the reference image itself, so it is a
		     faithful single-color fallback, not just an arbitrary average. -->
		<MauiIcon Include="Resources\AppIcon\appicon.svg" ForegroundFile="Resources\AppIcon\appiconfg.svg" ForegroundScale="1" Color="#392A24" />
		<!-- Same #392A24 fallback as the MauiIcon entry above, for the same reason: splash.svg bakes in its own
		     dark-brown gradient background and only needs a coherent letterbox tone behind it (design agent,
		     2026-10-28; see splash.svg's own comment for the full reasoning). -->
		<MauiSplashScreen Include="Resources\Splash\splash.svg" Color="#392A24" BaseSize="160,160" />
		<MauiImage Include="Resources\Images\*" />
		<MauiFont Include="Resources\Fonts\*" />
		<MauiAsset Include="Resources\Raw\**" LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />
	</ItemGroup>

	<ItemGroup>
		<!-- AdsService.Core needs >= 10.0.90 (same issue/fix as DocScanner/PdfReader): pin explicitly, the
		     workload's own $(MauiVersion) default resolves lower and causes an NU1605 downgrade error. -->
		<PackageReference Include="Microsoft.Maui.Controls" Version="10.0.90" />
		<PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="10.0.0" />
		<!-- MIT -->
		<PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
		<!-- MIT: on-device background-removal model inference (see LogoExtract.Core/Segmentation). -->
		<PackageReference Include="Microsoft.ML.OnnxRuntime" Version="1.20.1" />
		<!-- MIT: SKCanvasView for Views/MaskEditorView.cs's raw-SkiaSharp touch-paint brush tool. -->
		<PackageReference Include="SkiaSharp.Views.Maui.Controls" Version="3.116.1" />
		<!-- MIT: Play Billing wrapper for the Pro unlock (Services/LicenseService.cs), same package/version the
		     sibling PdfReader/Minesweeper apps already use for their own identical "Mua Pro" setup. -->
		<PackageReference Include="Plugin.InAppBilling" Version="10.0.0" />
		<!-- NU1107 version conflict: SkiaSharp.Views.Maui.Controls (via Microsoft.Maui.Core) wants 2.9.2.1,
		     LogoExtract.AdsService.LevelPlay (via GooglePlayServices.Basement -> AndroidX.Fragment) wants
		     2.11.0.1; pin to the higher one directly as NU1107 itself suggested. -->
		<PackageReference Include="Xamarin.AndroidX.Lifecycle.LiveData.Core" Version="2.11.0.1" />
		<!-- Duplicate-class D8 error (androidx.fragment.app.FragmentKt defined in both fragment.aar and
		     fragment-ktx.aar): SkiaSharp.Views.Maui.Controls (via Microsoft.Maui.Core) and
		     LogoExtract.AdsService.LevelPlay (via GooglePlayServices.Basement) resolve Fragment/Fragment.Ktx to
		     different versions whose native AARs don't dedupe cleanly; pin both explicitly to force one
		     resolved version everywhere (same fix shape as DocScanner's own CameraX/Fragment pin). -->
		<PackageReference Include="Xamarin.AndroidX.Fragment" Version="1.9.0" />
		<PackageReference Include="Xamarin.AndroidX.Fragment.Ktx" Version="1.9.0" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\LogoExtract.Core\LogoExtract.Core.csproj" />
		<ProjectReference Include="..\LogoExtract.AdsService.Core\LogoExtract.AdsService.Core.csproj" />
		<ProjectReference Include="..\LogoExtract.AdsService.LevelPlay\LogoExtract.AdsService.LevelPlay.csproj" />
	</ItemGroup>

</Project>
