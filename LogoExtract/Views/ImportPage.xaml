<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:LogoExtract.ViewModels"
             xmlns:views="clr-namespace:LogoExtract.Views"
             x:Class="LogoExtract.Views.ImportPage"
             x:DataType="vm:ImportViewModel"
             Title="Nhập ảnh"
             BackgroundColor="{AppThemeBinding Light={StaticResource BackgroundLight}, Dark={StaticResource BackgroundDark}}">
    <Grid>
        <VerticalStackLayout Padding="24" Spacing="14" VerticalOptions="Center">
            <Label Text="{x:Static views:Icons.Gallery}" FontFamily="{x:Static views:Icons.FontFamily}" FontSize="48"
                   HorizontalOptions="Center" Margin="0,0,0,8"
                   TextColor="{AppThemeBinding Light={StaticResource Secondary}, Dark={StaticResource Gray900}}" />
            <Label Text="Chụp hoặc chọn ảnh áo có logo. Có thể chọn nhiều ảnh cùng lúc để xử lý theo lô."
                   TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}"
                   HorizontalTextAlignment="Center" FontSize="13" Margin="0,0,0,12" />

            <!-- Chụp ảnh: primary pill, same shadow/radius treatment as HomePage's own CTA. -->
            <Border HeightRequest="56" StrokeThickness="0"
                    BackgroundColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="28" />
                </Border.StrokeShape>
                <Border.Shadow>
                    <Shadow Brush="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}" Opacity="0.35" Radius="14" Offset="0,6" />
                </Border.Shadow>
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding CaptureCommand}" />
                </Border.GestureRecognizers>
                <!-- PrimaryDarkText in BOTH themes (consistency pass, 2026-10-27) — see HomePage's own CTA
                     pill remarks: White-on-Primary fails WCAG AA at this brand hue's luminance regardless of theme. -->
                <HorizontalStackLayout HorizontalOptions="Center" VerticalOptions="Center" Spacing="8">
                    <Label Text="{x:Static views:Icons.Camera}" FontFamily="{x:Static views:Icons.FontFamily}" FontSize="19" VerticalOptions="Center"
                           TextColor="{StaticResource PrimaryDarkText}" />
                    <Label Text="Chụp ảnh" FontAttributes="Bold" VerticalOptions="Center"
                           TextColor="{StaticResource PrimaryDarkText}" />
                </HorizontalStackLayout>
            </Border>

            <!-- Chọn từ thư viện: outlined, secondary action. Tertiary in Light theme, not Primary (consistency
                 pass, 2026-10-27): Primary-as-foreground (border + icon + text) on this transparent/page
                 background measures ~2.6:1, under the 3:1 UI-component floor — see Colors.xaml's Tertiary
                 remarks. Dark theme's PrimaryDark-as-foreground on the dark page background is unaffected. -->
            <Border HeightRequest="56" StrokeThickness="1.5"
                    Stroke="{AppThemeBinding Light={StaticResource Tertiary}, Dark={StaticResource PrimaryDark}}"
                    BackgroundColor="Transparent">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="28" />
                </Border.StrokeShape>
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding PickCommand}" />
                </Border.GestureRecognizers>
                <HorizontalStackLayout HorizontalOptions="Center" VerticalOptions="Center" Spacing="8">
                    <Label Text="{x:Static views:Icons.Gallery}" FontFamily="{x:Static views:Icons.FontFamily}" FontSize="19" VerticalOptions="Center"
                           TextColor="{AppThemeBinding Light={StaticResource Tertiary}, Dark={StaticResource PrimaryDark}}" />
                    <Label Text="Chọn từ thư viện (nhiều ảnh)" FontAttributes="Bold" VerticalOptions="Center"
                           TextColor="{AppThemeBinding Light={StaticResource Tertiary}, Dark={StaticResource PrimaryDark}}" />
                </HorizontalStackLayout>
            </Border>
        </VerticalStackLayout>
        <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" VerticalOptions="Center" />

        <!-- Confirm/alert dialog overlay (added 2026-10-27) — this page's own ImportViewModel uses AppDialog
             for the "camera not supported" message instead of the native DisplayAlert it used before. -->
        <views:AppDialogOverlay />
    </Grid>
</ContentPage>
