<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:LogoExtract.ViewModels"
             x:Class="LogoExtract.Views.EditPage"
             x:DataType="vm:EditViewModel"
             Title="Chỉnh sửa">
    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="18">

            <Border StrokeShape="RoundRectangle 12" HeightRequest="280"
                    Stroke="{AppThemeBinding Light={StaticResource BorderLight}, Dark={StaticResource BorderDark}}">
                <Image Source="{Binding PreviewImageSource}" Aspect="AspectFit" BackgroundColor="#33808080" />
            </Border>

            <Label Text="Chỉnh màu" FontAttributes="Bold" FontSize="18"
                   TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}" />

            <VerticalStackLayout Spacing="4">
                <Label Text="Độ sáng" TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}" />
                <Slider Minimum="-1" Maximum="1" Value="{Binding Brightness}" />
            </VerticalStackLayout>

            <VerticalStackLayout Spacing="4">
                <Label Text="Tương phản" TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}" />
                <Slider Minimum="-1" Maximum="1" Value="{Binding Contrast}" />
            </VerticalStackLayout>

            <Button Text="Lưu chỉnh màu" Command="{Binding SaveColorCommand}"
                    BackgroundColor="{AppThemeBinding Light={StaticResource Secondary}, Dark={StaticResource Gray900}}"
                    TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}" />

            <BoxView HeightRequest="1" BackgroundColor="{AppThemeBinding Light={StaticResource BorderLight}, Dark={StaticResource BorderDark}}" />

            <Label Text="Vector hoá &amp; Xuất" FontAttributes="Bold" FontSize="18"
                   TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}" />
            <Label Text="Bản v1: tạo đường viền cắt (cut path) 1 màu, dùng được cho máy cắt decal/in chuyển nhiệt. Chưa phải vector tách nhiều vùng màu."
                   FontSize="12" TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}" />

            <Button Text="Vector hoá" Command="{Binding VectorizeCommand}"
                    BackgroundColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}"
                    TextColor="{AppThemeBinding Light=White, Dark={StaticResource PrimaryDarkText}}" FontAttributes="Bold" />

            <Button Text="Xuất / Chia sẻ" Command="{Binding ExportCommand}"
                    BackgroundColor="Transparent" BorderWidth="1.5"
                    BorderColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}"
                    TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}" />

            <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" />
            <Label Text="{Binding BusyText}" IsVisible="{Binding IsBusy}" HorizontalTextAlignment="Center" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
