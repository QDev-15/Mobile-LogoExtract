<?xml version="1.0" encoding="UTF-8" ?>
<?xaml-comp compile="true" ?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                     xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- Base template keys KEPT so Styles.xaml's existing control styles (Button/Entry/Slider/...) still resolve;
         Primary/PrimaryDark/OffBlack overridden to the LogoExtract mockup's mint brand (design agent, 2026-10-26).
         Light is the default theme (owner's explicit request 2026-10-27: see App.xaml.cs UserAppTheme). -->
    <Color x:Key="Primary">#1FAE82</Color>
    <Color x:Key="PrimaryDark">#27E3A3</Color>
    <Color x:Key="PrimaryDarkText">#0A0B0D</Color>
    <Color x:Key="Secondary">#DFF6EE</Color>
    <Color x:Key="SecondaryDarkText">#27E3A3</Color>
    <Color x:Key="Tertiary">#1A6B50</Color>

    <Color x:Key="White">White</Color>
    <Color x:Key="Black">Black</Color>
    <Color x:Key="Magenta">#D600AA</Color>
    <Color x:Key="MidnightBlue">#190649</Color>
    <Color x:Key="OffBlack">#0A0B0D</Color>

    <Color x:Key="Gray100">#E1E1E1</Color>
    <Color x:Key="Gray200">#C8C8C8</Color>
    <Color x:Key="Gray300">#ACACAC</Color>
    <Color x:Key="Gray400">#919191</Color>
    <Color x:Key="Gray500">#6E6E6E</Color>
    <Color x:Key="Gray600">#404040</Color>
    <Color x:Key="Gray900">#212121</Color>
    <Color x:Key="Gray950">#141414</Color>

    <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource Primary}"/>
    <SolidColorBrush x:Key="SecondaryBrush" Color="{StaticResource Secondary}"/>
    <SolidColorBrush x:Key="TertiaryBrush" Color="{StaticResource Tertiary}"/>
    <SolidColorBrush x:Key="WhiteBrush" Color="{StaticResource White}"/>
    <SolidColorBrush x:Key="BlackBrush" Color="{StaticResource Black}"/>

    <SolidColorBrush x:Key="Gray100Brush" Color="{StaticResource Gray100}"/>
    <SolidColorBrush x:Key="Gray200Brush" Color="{StaticResource Gray200}"/>
    <SolidColorBrush x:Key="Gray300Brush" Color="{StaticResource Gray300}"/>
    <SolidColorBrush x:Key="Gray400Brush" Color="{StaticResource Gray400}"/>
    <SolidColorBrush x:Key="Gray500Brush" Color="{StaticResource Gray500}"/>
    <SolidColorBrush x:Key="Gray600Brush" Color="{StaticResource Gray600}"/>
    <SolidColorBrush x:Key="Gray900Brush" Color="{StaticResource Gray900}"/>
    <SolidColorBrush x:Key="Gray950Brush" Color="{StaticResource Gray950}"/>

    <!-- LogoExtract-specific tokens (design agent mockup, 2026-10-26), used directly by this app's own pages. -->
    <Color x:Key="BackgroundLight">#F6F8F7</Color>
    <Color x:Key="BackgroundDark">#0A0B0D</Color>
    <Color x:Key="SurfaceLight">#FFFFFF</Color>
    <Color x:Key="SurfaceDark">#15171A</Color>
    <Color x:Key="TextPrimaryLight">#15181A</Color>
    <Color x:Key="TextPrimaryDark">#F2F4F3</Color>
    <Color x:Key="TextSecondaryLight">#5B6560</Color>
    <Color x:Key="TextSecondaryDark">#9AA6A0</Color>
    <Color x:Key="BorderLight">#E3E8E6</Color>
    <Color x:Key="BorderDark">#262A2D</Color>

    <Color x:Key="StateSegmenting">#2E7FD6</Color>
    <Color x:Key="StateFlattenWait">#D98A1F</Color>
    <Color x:Key="StateVectorized">#8A5CF0</Color>
    <Color x:Key="StateDone">#1FAE82</Color>
    <Color x:Key="StateError">#E0493B</Color>

</ResourceDictionary>
